"""toolchains_vivado: an ephemeral, Bazel-managed Vivado toolchain."""

module(
    name = "toolchains_vivado",

    # NOTE:
    # version = "",
    #
    # Always leave version unset or set to "" (the default). The default value
    # can prevent issues when the module is used via non-registry overrides
    # (e.g. https://github.com/bazel-contrib/rules_go/issues/4380).
    #
    # `publish-to-bcr` sets the version in the registry to the release version
    # by patching this MODULE.bazel file in the pull request to the BCR, so it
    # never needs to be maintained here.
    bazel_compatibility = [">=7.5.0"],
)

# rules_vivado owns the toolchain type this module registers against, and the
# `vivado_toolchain` rule that builds the provider. This module contributes an
# implementation of that toolchain type; it declares none of its own.
bazel_dep(name = "rules_vivado", version = "0.4.1")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "package_metadata", version = "0.0.6")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazelrc-preset.bzl", version = "1.6.0")

bazel_dep(name = "gazelle", version = "0.50.0", dev_dependency = True, repo_name = "bazel_gazelle")
bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.8.2", dev_dependency = True)
bazel_dep(name = "bazel_lib", version = "3.0.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.6.1", dev_dependency = True)
bazel_dep(name = "rules_verilog", version = "1.4.2", dev_dependency = True)

vivado = use_extension("//vivado:extensions.bzl", "vivado")
use_repo(vivado, "vivado_toolchains")

register_toolchains("@vivado_toolchains//:all")

# A synthetic installer archive that exercises the whole provisioning path --
# extract, ConfigGen, config rewrite, batch install, cache marker, shim -- in
# seconds and without an AMD account. See //vivado/tests.
vivado_dev = use_extension("//vivado:extensions.bzl", "vivado", dev_dependency = True)
vivado_dev.install(
    archive = "//vivado/tests:fake_installer.tar",
    modules = ["Artix-7"],
    vivado_version = "2025.2",
)
